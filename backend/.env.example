# ==========================================================================
# 智慧农业多语言一体机服务系统 · 后端环境变量模板
# 用法：复制本文件为 .env，按需填写。填哪家就用哪家；
#       全部留空 → 自动降级为本地知识库回答，系统依然完全可用。
# ==========================================================================

# ---------- 服务 ----------
APP_NAME=智慧农业多语言一体机服务系统
HOST=0.0.0.0
PORT=8002
DEBUG=true

# ---------- 数据库 ----------
DATABASE_URL=sqlite+aiosqlite:///./data/kiosk.db

# ---------- 认证（生产环境务必改掉 JWT_SECRET）----------
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---------- 上传 ----------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# ---------- 默认语言（6 选 1：zh-CN / en-US / ug-CN / kk-CN / bo-CN / mn-CN）----------
DEFAULT_LANG=zh-CN

# ==========================================================================
# 大模型接入：AI_PROVIDER 决定用哪一家
#   可选：zhipu | qwen | deepseek | moonshot | baidu | custom | none
#   留空或 none → 不调用大模型，农事问答走本地知识库检索（完全离线可用）
#   除 baidu 外均为 OpenAI 兼容接口，本项目按 OpenAI 协议统一调用
# ==========================================================================
AI_PROVIDER=

# ---------- 智谱 GLM（https://open.bigmodel.cn）----------
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-flash
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ---------- 阿里通义千问（https://dashscope.aliyun.com）----------
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- DeepSeek（https://platform.deepseek.com）----------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---------- 月之暗面 Kimi（https://platform.moonshot.cn）----------
MOONSHOT_API_KEY=
MOONSHOT_MODEL=moonshot-v1-8k
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# ---------- 百度文心（https://console.bce.baidu.com）----------
# 文心用 AK/SK 换 access_token，协议与 OpenAI 不同，走单独适配分支
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
BAIDU_MODEL=ernie-4.0-8k

# ---------- 自定义（任意 OpenAI 兼容端点，如本地 Ollama / vLLM）----------
CUSTOM_API_KEY=
CUSTOM_MODEL=
CUSTOM_BASE_URL=

# ---------- 调用参数 ----------
AI_TIMEOUT_SECONDS=30
AI_MAX_TOKENS=800
AI_TEMPERATURE=0.6

# ---------- 跨域（前端开发服务器）----------
CORS_ORIGINS=http://localhost:5189,http://127.0.0.1:5189
